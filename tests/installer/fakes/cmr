#!/bin/bash
# Fake cmr console script. Records how the launcher set it up.
echo "cmr $1 CMR_TESSERACT=${CMR_TESSERACT:-unset} ffmpeg=$(readlink -f "$(command -v ffmpeg)") PYTHONPATH=${PYTHONPATH:-unset}" >>"$FAKE_CALLS"
case $1 in
    --version) echo "cmr 0.0.1";;
    doctor) echo "ffmpeg: $(command -v ffmpeg)"
            if [ -n "${CMR_TESSERACT:-}" ]; then echo "tesseract (slate checks): $CMR_TESSERACT"
            else echo "tesseract (slate checks): NOT FOUND - fake"; fi
            echo "${FAKE_DOCTOR_OUT:-OK}"; exit "${FAKE_DOCTOR_RC:-0}";;
    check) out=""; while [ $# -gt 0 ]; do [ "$1" = -o ] && out=$2; shift; done
           mkdir -p "$out" && echo '{}' >"$out/cmr_report_latest.json"; exit 2;;
esac
